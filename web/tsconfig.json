{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@designcodeio/threeui": ["./src/shaders/landing-pages/LandingPages.tsx"],
      "@designcodeio/threeui/style.css": ["./src/shaders/threeui.css"]
    }
  },
  "include": ["src"]
}
