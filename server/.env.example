PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# ---- Local docker-compose defaults ----
DATABASE_URL=postgres://stocksync:stocksync@localhost:5432/stocksync
KAFKA_BROKERS=localhost:9092
OPENSEARCH_URL=http://localhost:9200

# ---- Aiven PostgreSQL ----
# DATABASE_URL=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
# PG_CA_PATH=./certs/pg-ca.pem        # recommended: full certificate verification (download CA from the Aiven console)

# ---- Aiven Kafka (client-certificate auth, the Aiven default) ----
# KAFKA_BROKERS=HOST:PORT
# KAFKA_SSL=true
# KAFKA_CA_PATH=./certs/kafka-ca.pem
# KAFKA_CERT_PATH=./certs/kafka-service.cert
# KAFKA_KEY_PATH=./certs/kafka-service.key
# ...or SASL instead of client certificates:
# KAFKA_SASL_USERNAME=avnadmin
# KAFKA_SASL_PASSWORD=PASSWORD
# KAFKA_SASL_MECHANISM=scram-sha-256

# ---- Aiven OpenSearch ----
# OPENSEARCH_URL=https://avnadmin:PASSWORD@HOST:PORT

# ---- Indian Payment Gateways ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PAYTM_MID=
PAYTM_MERCHANT_KEY=
