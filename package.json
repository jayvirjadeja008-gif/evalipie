{
  "name": "stocksync",
  "private": true,
  "scripts": {
    "setup": "npm --prefix server install && npm --prefix web install",
    "infra:up": "docker compose up -d",
    "db:init": "npm --prefix server run migrate && npm --prefix server run seed",
    "build": "npm --prefix web run build",
    "start": "npm --prefix server start",
    "worker": "npm --prefix server run worker",
    "dev:web": "npm --prefix web run dev",
    "test:stress": "npm --prefix server run stress",
    "test:consumers": "node server/scripts/consumer-logic-test.js",
    "test:e2e": "node server/scripts/e2e.js",
    "check:services": "npm --prefix server run check:services"
  }
}
